+        let expected = materialized_reference(data.clone(), &inputs, 2, &recipe).unwrap();
+        assert_bits(
+            &pool_tokens(&[1, 2, 3], &data, &inputs, 2, &recipe, |v| v).unwrap(),
+            &expected,
+        );
+    }
